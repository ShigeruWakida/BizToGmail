GOOGLE_OIDC_CLIENT_ID=your-google-client-id
GOOGLE_OIDC_CLIENT_SECRET=your-google-client-secret
GOOGLE_OIDC_REDIRECT_URI=https://your-cloud-run-url/auth/callback
BIZTOGMAIL_SESSION_SECRET=change-this-session-secret
BIZTOGMAIL_GCP_PROJECT=your-gcp-project-id
BIZTOGMAIL_SCHEDULER_TOKEN=change-this-scheduler-token
DATABASE_URL=postgresql+pg8000://USER:PASSWORD@/DBNAME?unix_sock=/cloudsql/PROJECT:REGION:INSTANCE/.s.PGSQL.5432
